#================= Vonage API =====================

# All following parameters are available from the dashboard (dashboard.vonage.com) 

# Your Vonage account API key
API_KEY=xxxxxxxxx

# Your Vonage account API secret
API_SECRET=xxxxxxxx

# Your application ID 
APP_ID=xxxxxxxxxxx

# A phone number linked to your application
SERVICE_NUMBER=12995550101

#---

# List of allowable client SDK (WebRTC client) users
CLIENT_SDK_USERS=john,jennifer,paul,sarah

#==== Default language code for STT ====
STT_LANGUAGE_CODE=en-US

#==== Middleware server ====

# Back end server host name (no prefix such as "https://" or "wss://", and no trailing slash "/")
PROCESSOR_SERVER=xxxxxx.ngrok.xxx
#PROCESSOR_SERVER=myserver.mycompany.com









